# > AppleAI — Apple Intelligence / Siri / Private Cloud Compute
# Official endpoints from https://support.apple.com/en-us/101555
# Section: "Apple Intelligence, Siri, and Search"
#
# These rules route Apple AI/Siri traffic through a dedicated proxy group
# for optimal performance and regional access. Placed before generic
# Apple.list and CloudflareProxy.list to ensure precedence.

# Siri and dictation (TCP 443)
DOMAIN,guzzoni.apple.com

# Search services: Siri, Spotlight, Lookup, Safari, News, Messages, Music (TCP 443)
DOMAIN-SUFFIX,smoot.apple.com

# Apple Intelligence Extensions (TCP/UDP 443)
DOMAIN,apple-relay.apple.com

# Private Cloud Compute (PCC) relays (TCP/UDP 443)
DOMAIN,apple-relay.cloudflare.com
DOMAIN,apple-relay.fastly-edge.com
DOMAIN,cp4.cloudflare.com
